{
  "name": "@tech-canvas-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tech Canvas Studio - Desktop application for Linux",
  "main": "dist/main.js",
  "homepage": "https://github.com/techengineerworkstation/tech-canvas-studio",
  "author": {
    "name": "TechEngineer Workstation",
    "email": "tech@example.com"
  },
  "license": "MIT",
  "desktopName": "tech-canvas-studio",
  "scripts": {
    "dev": "tsc --watch & electron . --dev",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "cp -r src/assets dist/assets 2>/dev/null || true && cp -r icons dist/icons 2>/dev/null || true",
    "package": "npm run build && electron-builder",
    "clean": "rm -rf dist dist-electron",
    "dist": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0"
  }
}
